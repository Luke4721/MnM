# Copy to .env.local and fill in real values. Never commit .env.local.
# Razorpay dashboard -> Settings -> API Keys (test keys start with rzp_test_).

# Public key ID. Safe to expose: Razorpay Checkout needs it in the browser.
# NOTE: Vite only exposes variables prefixed with VITE_ (the Next.js equivalent
# would be NEXT_PUBLIC_, which does nothing in a Vite app).
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx

# Server-side key ID, used by /api/create-order to authenticate the Orders API call.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx

# SECRET. Server-side only, read by /api/*. Never prefix with VITE_.
RAZORPAY_KEY_SECRET=your_key_secret

# Optional: reject orders above this rupee amount. Unset = only the built-in
# ₹1 crore sanity bound.
# MAX_ORDER_AMOUNT_INR=500000

# --- Admin API Protection ---------------------------------------------------
# Shared secret required on POST / PUT / DELETE mutation requests to /api/admin/*
ADMIN_API_TOKEN=your_secure_admin_token
VITE_ADMIN_API_TOKEN=your_secure_admin_token

# S3 bucket that images are uploaded to. Required for a live run.
S3_BUCKET=your-bucket-name
# Bucket region (also picked up from the standard AWS config if unset).
AWS_REGION=ap-south-1
# Optional CloudFront distribution domain — if set, blog featuredImage URLs
# use https://<domain>/blog-images/<slug>.jpg instead of the raw S3 URL.
# AWS_CLOUDFRONT_DOMAIN=d123abc.cloudfront.net
# Stock photo API keys — at least one is required. Pixabay is queried first
# and paced fast (IMAGE_PIXABAY_DELAY_MS, default 200ms) because its limit is
# ~5,000 requests/hour; Unsplash/Pexels are slower and used as fallbacks.
PIXABAY_API_KEY=your_pixabay_api_key
UNSPLASH_ACCESS_KEY=your_unsplash_access_key
PEXELS_API_KEY=your_pexels_api_key
# Optional: delay between stock API calls in ms (default 1000; Pixabay 200).
# IMAGE_FETCH_DELAY_MS=1000
# IMAGE_PIXABAY_DELAY_MS=200
# Optional: S3 key of a pre-uploaded default placeholder (default shown).
# DEFAULT_IMAGE_KEY=blog-images/default-travel.jpg

# --- Internal Retool Operations Portal --------------------------------------
# Published Retool embed URLs for /admin/portal
# If unset, defaults to "[PASTE_YOUR_PUBLISHED_RETOOL_COMMAND_CENTER_URL_HERE]"
# VITE_RETOOL_COMMAND_CENTER_URL=https://your-org.retool.com/embedded/public/...
# VITE_RETOOL_TELECALLER_APP_URL=https://your-org.retool.com/embedded/public/...

