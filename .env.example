# Copy to .env.local and fill in real values. Never commit .env.local.
# Razorpay dashboard -> Settings -> API Keys (test keys start with rzp_test_).

# Public key ID. Safe to expose: Razorpay Checkout needs it in the browser.
# NOTE: Vite only exposes variables prefixed with VITE_ (the Next.js equivalent
# would be NEXT_PUBLIC_, which does nothing in a Vite app).
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx

# Server-side key ID, used by /api/create-order to authenticate the Orders API call.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx

# SECRET. Server-side only, read by /api/*. Never prefix with VITE_.
RAZORPAY_KEY_SECRET=your_key_secret

# Optional: reject orders above this rupee amount. Unset = only the built-in
# ₹1 crore sanity bound.
# MAX_ORDER_AMOUNT_INR=500000
